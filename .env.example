# Copy to .env and fill in. Never commit .env or paste the token anywhere.
JIRA_SITE=gengalactic.atlassian.net
JIRA_EMAIL=you@gengalactic.com
JIRA_API_TOKEN=
JIRA_PROJECT=LAB
# Permanent equipment IDs look like GG-EQ-000012 (not tied to a stand, since equipment moves)
EQUIP_PREFIX=GG-EQ
# Equipment ID of the rack new instruments go into by default (after `add-rack`), e.g. GG-EQ-000001
DEFAULT_RACK=
# How a Conditional calibration result counts: unknown (default) or valid
CONDITIONAL_COUNTS_AS=unknown
# Windows printer name once the P-touch is installed, e.g. Brother PT-P710BT
LABEL_PRINTER=
